# Server
PORT=4000
NODE_ENV=development

# Database (Railway PostgreSQL)
DATABASE_URL=postgresql://user:password@host:5432/gradispace

# JWT
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=30d

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_SCHOOL=price_...

# Resend (email)
RESEND_API_KEY=re_...
EMAIL_FROM=noreply@gradispace.com

# Anthropic (AI generation — platform-level key, never sent to client)
ANTHROPIC_API_KEY=sk-ant-...

# Frontend URL (for CORS and email links)
CLIENT_URL=https://gradispace.com
